{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "technologies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "githubUrl": { "type": "string" },
    "websiteUrl": { "type": "string" }
  },
  "required": ["id", "name", "description", "technologies", "githubUrl", "websiteUrl"]
}
